cal socket rpc(default)"]},"luahelper.base.lspserverLog":{"default":false,"scope":"resource","type":"boolean","description":"Whether to open lsp server log"},"luahelper.base.requirePathSeparator":{"type":"string","default":".","enum":[".","/"],"description":"require other file path's separator, default is . , Example: require('one.bb')","enumDescriptions":["default is . Example: require('one.bb')","set as / Example: require('one/bb')"]},"luahelper.base.ignoreFileOrDir":{"default":[".vscode/","one11.lua"],"items":{"type":"string"},"markdownDescription":"Ignore analysis files and directories. Sample：one11.lua , indicates to ignore files; .vscode/ , indicates to ignore directories.","scope":"resource","type":"array"},"luahelper.base.ignoreFileOrDirError":{"default":[".vscode/","one11.lua"],"items":{"type":"string"},"markdownDescription":"Ignored file and directory errors. Sample: one11.lua,  indicates to ignore file errors, .vscode/ , indicates to ignore directory errors.","scope":"resource","type":"array"},"luahelper.base.referenceMaxNum":{"default":3000,"scope":"resource","type":"integer","description":"Maximum number of references show"},"luahelper.base.referenceIncudeDefine":{"default":true,"scope":"resource","type":"boolean","description":"Whether to include definitions when displaying references"},"luahelper.base.showOnline":{"default":false,"scope":"resource","type":"boolean","description":"Show online people number"},"luahelper.base.showCostTime":{"default":false,"scope":"resource","type":"boolean","description":"Show plugin startup time"},"luahelper.base.formatErrShow":{"default":false,"scope":"resource","type":"boolean","description":"If the format is wrong, whether to display the error"},"luahelper.base.PreviewFieldsNum":{"default":30,"scope":"resource","type":"integer","description":"When hovering to view a table, limits the maximum number of previews for fields."},"luahelper.format.0 allReadMe":{"default":"https://github.com/Koihik/LuaFormatter","scope":"resource","type":"string","markdownDescription":"Read all formatting settings [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md).\n"},"luahelper.format.column_limit":{"default":120,"scope":"resource","type":"integer","markdownDescription":"Column limit of one line [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#column_limit).\n"},"luahelper.format.indent_width":{"default":4,"scope":"resource","type":"integer","markdownDescription":"The number of spaces used for indentation [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#indent_width).\n"},"luahelper.format.use_tab":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Use tab for indent [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#use_tab).\n"},"luahelper.format.tab_width":{"default":4,"scope":"resource","type":"integer","markdownDescription":"The number of spaces used for tab"},"luahelper.format.continuation_indent_width":{"default":4,"scope":"resource","type":"integer","markdownDescription":"Indent width for continuations line [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#continuation_indent_width).\n"},"luahelper.format.keep_simple_function_one_line":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Allow format simple function to one line [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#keep_simple_function_one_line).\n"},"luahelper.format.spaces_before_call":{"default":1,"scope":"resource","type":"integer","markdownDescription":"Inserts a space on function calls with parentheses omitted [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#spaces_before_call).\n"},"luahelper.format.keep_simple_control_block_one_line":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Allow format simple control block(e.g., if, while, for, ...) to one line [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#keep_simple_control_block_one_line).\n"},"luahelper.format.align_args":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Align arguments of a function call if there is a line break. If false, use continuation_indent_width to indentation [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#align_args).\n"},"luahelper.format.break_after_functioncall_lp":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Break after '(' of function call if columns greater than column_limit [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#break_after_functioncall_lp).\n"},"luahelper.format.break_before_functioncall_rp":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Break before ')' of function call if columns greater than column_limit [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#break_before_functioncall_rp).\n"},"luahelper.format.align_parameter":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Align parameter of function define if there is a line break. if false, use continuation_indent_width to indentation [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#align_parameter).\n"},"luahelper.format.chop_down_parameter":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Chop down all parameters if the function declaration doesn’t fit on a line [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#chop_down_parameter).\n"},"luahelper.format.break_after_functiondef_lp":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Break after '(' of function define if columns greater than column_limit [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#break_after_functiondef_lp).\n"},"luahelper.format.break_before_functiondef_rp":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Break before ')' of function define if columns greater than column_limit [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#break_before_functiondef_rp).\n"},"luahelper.format.align_table_field":{"default":true,"scope":"resource","type":"boolean","markdownDescription":"Align fields of a table if there is a line break. if false, use indent_width to indentation [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#align_table_field).\n"},"luahelper.format.break_after_table_lb":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Break after '{' of a table if columns greater than column_limit [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#break_after_table_lb).\n"},"luahelper.format.break_before_table_rb":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Break before '}' of a table if columns greater than column_limit [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#break_before_table_rb).\n"},"luahelper.format.chop_down_table":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Chop down any table [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#chop_down_table).\n"},"luahelper.format.chop_down_kv_table":{"default":true,"scope":"resource","type":"boolean","markdownDescription":"Chop down table if a table contains a key [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#chop_down_kv_table).\n"},"luahelper.format.table_sep":{"default":",","scope":"resource","type":"string","markdownDescription":"Define character to separate table fields [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#table_sep).\n"},"luahelper.format.extra_sep_at_table_end":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Add an extra field separator after the last field unless the table is in a single line [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#extra_sep_at_table_end).\n"},"luahelper.format.break_after_operator":{"default":true,"scope":"resource","type":"boolean","markdownDescription":"Put break after operators if columns greater than column_limit. If false, put break before operators [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#break_after_operator).\n"},"luahelper.format.double_quote_to_single_quote":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Transform string literals to use a single quote [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#double_quote_to_single_quote).\n"},"luahelper.format.single_quote_to_double_quote":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Transform string literals to use double quotes [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#single_quote_to_double_quote).\n"},"luahelper.format.spaces_inside_functiondef_parens":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Inserts spaces inside the parenthesis in a function header [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#spaces_inside_functiondef_parens).\n"},"luahelper.format.spaces_inside_functioncall_parens":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Inserts spaces inside the parenthesis in a function call [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#spaces_inside_functioncall_parens).\n"},"luahelper.format.spaces_inside_table_braces":{"default":false,"scope":"resource","type":"boolean","markdownDescription":"Inserts spaces inside the braces in a table constructor [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#spaces_inside_table_braces).\n"},"luahelper.format.spaces_around_equals_in_field":{"default":true,"scope":"resource","type":"boolean","markdownDescription":"Inserts spaces around the equal sign in key/value fields. Other assignments are not affected, though they may be affected by other options or behavior of the formatter [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#spaces_around_equals_in_field).\n"},"luahelper.format.line_breaks_after_function_body":{"default":1,"scope":"resource","type":"integer","markdownDescription":"Line breaks after the function body [here](https://github.com/Koihik/LuaFormatter/blob/master/docs/Style-Config.md#line_breaks_after_function_body).\n"},"luahelper.Warn.AllEnable":{"default":true,"scope":"resource","type":"boolean","description":"Check warn is all enable)"},"luahelper.Warn.CheckSyntax":{"default":true,"scope":"resource","type":"boolean","description":"[Warn Type:1], basic synctax check"},"luahelper.Warn.CheckNoDefine":{"default":false,"scope":"resource","type":"boolean","description":"[Warn Type:2], var not define check"},"luahelper.Warn.CheckAfterDefine":{"default":false,"scope":"resource","type":"boolean","description":"[Warn Type:3], var define after use"},"luahelper.Warn.CheckLocalNoUse":{"default":false,"scope":"resource","type":"boolean","description":"[Warn Type:4], local var define not use"},"luahelper.Warn.CheckTableDuplicateKey":{"default":true,"scope":"resource","type":"boolean","description":"[Warn Type:5], table define duplicate key"},"luahelper.Warn.CheckReferNoFile":{"default":false,"scope":"resource","type":"boolean","description":"[Warn Type:6], refer file not exist"},"luahelper.Warn.CheckAssignParamNum":{"default":true,"scope":"resource","type":"boolean","description":"[Warn Type:7], assign statement param num error"},"luahelper.Warn.CheckLocalDefineParamNum":{"default":true,"scope":"resource","type":"boolean","description":"[Warn Type:8], local define statement param num error"},"luahelper.Warn